/*
 * Corne UK ISO — starter keymap
 * Layers: 0 Base, 1 Lower, 2 Raise, 3 Adjust (tri-layer)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/corne.h"

// ─── Position groups for HRMs ────────────────────────────────────
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5  LM0 LM1 LM2 LM3 LM4 LM5  LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5  RM0 RM1 RM2 RM3 RM4 RM5  RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

// ─── Home row mods (GACS — Gui/Alt/Ctrl/Shift, index = Ctrl) ─────
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

// ─── Tri-state: smart Alt-Tab ────────────────────────────────────
// Tap once → Alt+Tab fires and Alt stays held. Keep tapping the
// same key to step through windows. Press anything else, or wait,
// and Alt releases. (Optional — remove if you'd rather not.)
ZMK_TRI_STATE(swapper,
    bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
    ignored-key-positions = <RT4>;   // RT4 = the key bound to &kp LS(TAB) for back-stepping
)

// ─── Tri-layer: Lower + Raise → Adjust ───────────────────────────
ZMK_CONDITIONAL_LAYER(adjust, 1 2, 3)

// ─── Example combo: J + K → Esc (base layer only) ────────────────
ZMK_COMBO(combo_esc, &kp ESC, RM1 RM2, 0)

// ─── Layers ──────────────────────────────────────────────────────

ZMK_LAYER(base,
//╭───────────┬─────────────┬─────────────┬──────────────┬──────────────┬───────────╮ ╭───────────┬──────────────┬──────────────┬─────────────┬─────────────────┬──────────╮
//│   TAB     │      Q      │      W      │      E       │      R       │     T     │ │     Y     │      U       │      I       │      O      │       P         │   BSPC   │
//│  LCTRL    │   A / GUI   │   S / ALT   │   D / SHFT   │   F / CTRL   │     G     │ │     H     │   J / CTRL   │   K / SHFT   │   L / ALT   │    ; / GUI      │    '     │
//│  LSHFT    │      Z      │      X      │      C       │      V       │     B     │ │     N     │      M       │      ,       │      .      │       /         │   ESC    │
//╰───────────┴─────────────┴─────────────┼──────────────┼──────────────┼───────────┤ ├───────────┼──────────────┼──────────────┼─────────────┴─────────────────┴──────────╯
//                                        │     LGUI     │   LWR (mo1)  │    SPC    │ │    ENT    │  RSE (mo2)   │     DEL      │
   &kp TAB    &kp Q         &kp W         &kp E          &kp R          &kp T         &kp Y       &kp U          &kp I          &kp O         &kp P             &kp BSPC
   &kp LCTRL  &hml LGUI A   &hml LALT S   &hml LSHFT D   &hml LCTRL F   &kp G         &kp H       &hmr RCTRL J   &hmr RSHFT K   &hmr LALT L   &hmr LGUI SEMI    &kp SQT
   &kp LSHFT  &kp Z         &kp X         &kp C          &kp V          &kp B         &kp N       &kp M          &kp COMMA      &kp DOT       &kp FSLH          &kp ESC
                                          &kp LGUI       &mo 1          &kp SPACE     &kp RET     &mo 2          &kp DEL
)

ZMK_LAYER(lower,
//╭───────────┬─────────────┬─────────────┬──────────────┬──────────────┬─────────────╮ ╭───────────┬──────────────┬──────────────┬─────────────┬───────────┬──────────╮
//│   TAB     │      1      │      2      │      3       │      4       │      5      │ │     6     │      7       │      8       │      9      │     0     │   BSPC   │
//│  LCTRL    │             │             │              │              │             │ │           │              │              │             │     ↑     │          │
//│  LSHFT    │             │             │              │              │             │ │           │              │              │      ←      │     ↓     │    →     │
//╰───────────┴─────────────┴─────────────┼──────────────┼──────────────┼─────────────┤ ├───────────┼──────────────┼──────────────┼─────────────┴───────────┴──────────╯
//                                        │     LGUI     │              │     SPC     │ │    ENT    │              │     DEL      │
   &kp TAB    &kp N1        &kp N2        &kp N3         &kp N4         &kp N5          &kp N6      &kp N7         &kp N8         &kp N9        &kp N0      &kp BSPC
   &kp LCTRL  &trans        &trans        &trans         &trans         &trans          &trans      &trans         &trans         &trans        &kp UP      &trans
   &kp LSHFT  &trans        &trans        &trans         &trans         &trans          &trans      &trans         &trans         &&kp LEFT     &kp DOWN    &kp RIGHT
                                          &kp LGUI       &trans         &kp SPACE       &kp RET     &trans         &kp DEL
)

ZMK_LAYER(raise,
//╭───────────┬─────────────┬─────────────┬──────────────┬──────────────┬─────────────╮ ╭───────────┬──────────────┬──────────────┬─────────────┬───────────┬──────────╮
//│   TAB     │      !      │      @      │      #       │      $       │      %      │ │     ^     │      &       │      *       │      (      │     )     │   BSPC   │
//│  LCTRL    │             │             │              │              │             │ │     -     │      =       │      [       │      ]      │     #     │     `    │
//│  LSHFT    │      _      │      +      │      {       │      }       │      |      │ │     ~     │      <       │      >       │      ?      │     |     │     ~    │
//╰───────────┴─────────────┴─────────────┼──────────────┼──────────────┼─────────────┤ ├───────────┼──────────────┼──────────────┼─────────────┴───────────┴──────────╯
//                                        │     LGUI     │              │     SPC     │ │    ENT    │              │     DEL      │
   &kp TAB    &kp EXCL      &kp DQT       &kp HASH       &kp DLLR       &kp PRCNT       &kp CARET   &kp AMPS       &kp ASTRK      &kp LPAR      &kp RPAR    &kp BSPC
   &kp LCTRL  &trans        &trans        &trans         &trans         &trans          &kp MINUS   &kp EQUAL      &kp LBKT       &kp RBKT      &kp NUHS    &kp GRAVE
   &kp LSHFT  &kp UNDER     &kp PLUS      &kp LBRC       &kp RBRC       &kp PIPE        &kp TILDE   &kp LT         &kp GT         &kp QMARK     &kp PIPE    &kp TILDE
                                          &kp LGUI       &trans         &kp SPACE       &kp RET     &trans         &kp DEL
)

ZMK_LAYER(adjust,
//╭───────────┬─────────────┬─────────────┬──────────────┬──────────────┬─────────────╮ ╭───────────┬──────────────┬──────────────┬─────────────┬───────────┬──────────╮
//│  BOOT     │             │             │              │              │             │ │           │              │              │             │           │   BOOT   │
//│  RESET    │     BT0     │     BT1     │     BT2      │     BT3      │     BT4     │ │ CAPS_WORD │              │              │   USB OUT   │  BLE OUT  │   RESET  │
//│           │   BT_CLR    │             │              │              │             │ │           │              │              │             │           │          │
//╰───────────┴─────────────┴─────────────┼──────────────┼──────────────┼─────────────┤ ├───────────┼──────────────┼──────────────┼─────────────┴───────────┴──────────╯
//                                        │              │              │             │ │           │              │              │
   &bootloader &none        &none         &none          &none          &none           &none       &none          &none          &none         &none       &bootloader
   &sys_reset  &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4    &caps_word  &none          &none          &out OUT_USB  &out OUT_BLE &sys_reset
   &none       &bt BT_CLR   &none         &none          &none          &none           &none       &none          &none          &none         &none       &none
                                          &trans         &trans         &trans          &trans      &trans         &trans
)